# Release variables for fastlane (see docs/technical-solutions/build-release.md).
# Copy to .env (untracked) or set them in the shell. Never commit values; key files live outside the repo.

# Apple
APPLE_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Headless signing on the build Mac (optional)
BOOKFETCH_BUILD_KEYCHAIN=
BOOKFETCH_BUILD_KEYCHAIN_PASSWORD_FILE=

# Google Play
PLAY_JSON_KEY_PATH=
ANDROID_UPLOAD_STORE_FILE=
ANDROID_UPLOAD_STORE_PASSWORD=
ANDROID_UPLOAD_KEY_ALIAS=
ANDROID_UPLOAD_KEY_PASSWORD=
